{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:payroll": "node server/payroll.test.mjs",
    "test:lifecycle": "node worker/lifecycleDocuments.test.mjs",
    "test:recruitment": "node worker/recruitmentService.test.mjs && node worker/recruitmentOffers.test.mjs",
    "test:operations": "node worker/operations.test.mjs",
    "check:payslip-pdfs": "node server/renderPayslipSamples.mjs",
    "test:appraisals": "node worker/appraisals.test.mjs && node server/appraisalPayroll.test.mjs",
    "test:overview": "node worker/overview.test.mjs",
    "test:mail": "node server/internalMail.test.mjs",
    "test:mail-external": "node server/mail.test.mjs"
  },
  "dependencies": {
    "@aejkatappaja/phantom-ui": "^1.6.1",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@google/genai": "^2.4.0",
    "@radix-ui/react-toolbar": "^1.1.19",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.6",
    "aws4fetch": "^1.0.20",
    "dagre": "^0.8.5",
    "docx": "^9.8.0",
    "dompurify": "^3.4.16",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "flowbite": "^4.0.2",
    "gsap": "^3.15.0",
    "imapflow": "^2.11.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.14.3",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.5.0",
    "react": "^19.0.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.1",
    "react-easy-crop": "^6.2.5",
    "recharts": "^3.10.1",
    "sass": "^1.104.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/dagre": "^0.7.54",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "^6.3.289",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
