GEMINI_API_KEY=
# Razorpay test-mode billing. Never prefix secrets with VITE_.
BILLING_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Invisible reCAPTCHA v2. Secret is server-only; never use a VITE_ prefix.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=nexthr.com,www.nexthr.com,localhost,127.0.0.1
# Payroll Studio server configuration (never expose these as VITE_ variables).
# Existing database ID and bucket are read from wrangler.toml unless overridden.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# HTTPS verifier: Bearer token -> { success: true, data: { userid, company_id, type } }
# Company Calendar requires a verified company_id; company_admin role is also supported.
PAYROLL_AUTH_VERIFY_URL=
# Explicit opt-in, loopback-only local development. Disabled in production.
PAYROLL_LOCAL_DEV=false
# Calendarific API Key for realtime holidays fetch
CALENDARIFIC_API_KEY=
