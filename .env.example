GEMINI_API_KEY=
# Razorpay live billing. Never prefix secrets with VITE_.
BILLING_MODE=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Invisible reCAPTCHA v2. Secret is server-only; never use a VITE_ prefix.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=nexthr.com,www.nexthr.com,localhost,127.0.0.1
# Payroll Studio server configuration (never expose these as VITE_ variables).
# Existing database ID and bucket are read from wrangler.toml unless overridden.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# HTTPS verifier: Bearer token -> { success: true, data: { userid, company_id, type } }
# Company Calendar requires a verified company_id; company_admin role is also supported.
PAYROLL_AUTH_VERIFY_URL=
# Explicit opt-in, loopback-only local development. Disabled in production.
PAYROLL_LOCAL_DEV=false
# Calendarific API Key for realtime holidays fetch
CALENDARIFIC_API_KEY=
# HR document delivery (verified Resend sender; server-only values).
RESEND_API_KEY=
DOCUMENT_EMAIL_FROM=
# Offer response signing secret, server-only. Use at least 32 random characters.
RECRUITMENT_TOKEN_SECRET=
# Public application origin, e.g. https://nexthr.com or http://localhost:3000.
HRMS_PUBLIC_APP_URL=

# Company SMTP/IMAP Mail (Node server only)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_ENCRYPTION_KEY=
MAIL_DATA_DIR=data/mail
