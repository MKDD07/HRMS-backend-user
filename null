:root {
  --color-slate-50: #f8fafc;
  --color-slate-100: #f1f5f9;
  --color-slate-200: #e2e8f0;
  --color-slate-400: #90a1b9;
  --color-slate-500: #62748e;
  --color-gray-50: #f7f7f8;
  --color-gray-100: #eeeef0;
  --color-gray-200: #d9d9de;
  --color-gray-300: #b7b8c2;
  --color-gray-400: #9394a1;
  --color-gray-500: #747686;
  --color-gray-600: #5e5f6e;
  --color-gray-700: #42434d;
  --color-gray-800: #2f3037;
  --color-gray-900: #212126;
  --color-gray-950: #131316;
  --td-line: #e6e8eb;
  --td-line-light: #f0f2f5;
  --td-muted: #6c727a;
  --td-subtle: #8a919a;
  --td-accent: #27292c;
  --td-focus: #27292c;
  --td-bg-subtle: #f7f8f9;
  --td-bg-muted: #f0f2f4;
  --color-primary: #27292c;
  --color-primary-dark: #1a1b1d;
  --color-primary-light: #484b50;
  --color-primary-subtle: #f1f2f4;
  --color-surface: #ffffff;
  --color-surface-subtle: #fbfbfb;
  --color-text: #27292c;
  --color-text-secondary: #4b4f56;
  --color-text-muted: #6c727a;
  --color-border: #e6e8eb;
  --color-success: #2e7d32;
  --color-danger: #d32f2f;
  --color-warning: #ed6c02;
  --color-info: #0288d1;
}

:root {
  /* Core colors */
  --text-color: 23 23 23;
  --highlight-color: 255 221 191;
  --background-color: 255 255 255;
  --button-bg: 23 23 23;
  --button-bg-gradient: #171717;
  --button-primary-gradient: linear-gradient(135deg, var(--color-gray-700), var(--color-gray-900) 50%, var(--color-gray-950));
  --button-text-color: 255 255 255;
  --focus-outline-color: 11 97 205;
  --shadow-color: 168 232 226;
  --shadow-main: 0 1px 1px var(--tw-shadow-color, #0000000d), 0 4px 6px var(--tw-shadow-color, #222a350a), 0 24px 68px var(--tw-shadow-color, #2f30370d), 0 2px 3px var(--tw-shadow-color, #0000000a);
  --placeholder-color: 250 250 250;
  /* Status messages */
  --success-text: 77 124 15;
  --success-bg: 247 254 231;
  --error-text: 225 29 72;
  --error-bg: 255 241 242;
  --info-text: 180 83 9;
  --info-bg: 255 251 235;
  /* Drawer / side panel */
  --drawer-text: 23 23 23;
  --drawer-bg: 255 255 255;
  --drawer-button-bg: 23 23 23;
  --drawer-button-gradient: #171717;
  --drawer-button-text: 255 255 255;
  --drawer-overlay: 23 23 23;
  /* Card styling */
  --card-radius: var(--radius-card);
  --card-border-width: 0px;
  --card-border-opacity: 0.0;
  --card-shadow-opacity: 0.1;
  --card-shadow-x: 0px;
  --card-shadow-y: 0px;
  /* Button styling */
  --button-radius: var(--radius-button);
  --button-border-width: 2px;
  --button-border-opacity: 1.0;
  --button-shadow-opacity: 0.0;
  --button-shadow-x: 0px;
  --button-shadow-y: 0px;
  /* Input styling */
  --input-radius: var(--radius-input);
  --input-border-width: 0px;
  --input-border-opacity: 0.65;
  /* Spacing scale */
  --space-0-5: 2px;
  --space-1: 4px;
  --space-1-5: 6px;
  --space-2: 8px;
  --space-2-5: 10px;
  --space-3: 12px;
  --space-3-5: 14px;
  --space-4: 16px;
  --space-4-5: 18px;
  --space-5: 20px;
  --space-5-5: 22px;
  --space-6: 24px;
  --space-6-5: 26px;
  --space-7: 28px;
  --space-7-5: 30px;
  --space-8: 32px;
  --space-8-5: 34px;
  --space-9: 36px;
  --space-9-5: 38px;
  --space-10: 40px;
  --space-10-5: 42px;
  --space-11: 44px;
  --space-12: 48px;
  --space-13: 52px;
  --space-14: 56px;
  --space-15: 62px;
  --space-16: 64px;
  --space-18: 72px;
  --space-20: 80px;
  --space-23: 90px;
  --space-24: 96px;
  --space-28: 112px;
  --space-32: 128px;
  --space-36: 144px;
  --space-40: 160px;
  --space-44: 176px;
  --space-48: 192px;
  --space-52: 208px;
  --space-56: 224px;
  --space-60: 240px;
  --space-64: 256px;
  --space-68: 272px;
  --space-72: 288px;
  --space-80: 320px;
  --space-96: 384px;
  --space-100: 512px;
  --font-family-base: Google Sans Text, Google Sans, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif;
  --font-family-display: Google Sans, Google Sans Text, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif;
  --font-family-nav: Google Sans Text, Google Sans, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif;
  --font-family-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  /* Typography */
  --heading-font-family: var(--font-family-display);
  --heading-font-style: normal;
  --heading-font-weight: 700;
  --heading-line-height: 1;
  --heading-letter-spacing: -0.03em;
  --body-font-family: var(--font-family-base);
  --body-font-style: normal;
  --body-font-weight: 400;
  --body-line-height: 1.2;
  --body-letter-spacing: 0.0em;
  --nav-font-family: var(--font-family-nav);
  --nav-font-size: clamp(14px, 11.968px + 0.3174vw, 18px);
  --nav-font-weight: 500;
  --button-font-family: var(--body-font-family);
  --button-font-size: clamp(14px, 12.984px + 0.1587vw, 16px);
  --button-font-weight: 500;
  --product-font-family: var(--body-font-family);
  --product-font-size: clamp(16px, 13.968px + 0.3175vw, 20px);
  --product-font-weight: 500;
  /* Font size scale */
  --font-3xs: 10px;
  --font-2xs: 11px;
  --font-xs: 12px;
  --font-2sm: 13px;
  --font-sm: 14px;
  --font-base: 16px;
  --font-lg: 18px;
  --font-xl: 20px;
  --font-2xl: 24px;
  --font-3xl: 30px;
  --font-4xl: 36px;
  --font-5xl: 48px;
  --font-6xl: 60px;
  --font-7xl: 72px;
  --font-8xl: 96px;
  /* Layout */
  --page-width: 1900px;
  --gap-padding: clamp(var(--space-5), 2.526vw, var(--space-12));
  --grid-gap: clamp(40px, 20vw, 60px);
  --page-padding: var(--space-5);
  --page-container: min(calc(100vw - var(--page-padding) * 2), var(--page-width));
  /* Border radius */
  --radius-button: 9999px;
  --radius-input: 6px;
  --radius-card: 12px;
  --radius-block: clamp(var(--space-2-5), 1.053vw, var(--space-5));
  --icon-weight: 1.5px;
  --background: var(--background-color);
  --background-2: var(--background-color);
  --foreground: var(--text-color);
  --border: var(--foreground)/ 0.1;
  --border-dark: var(--foreground)/ 0.4;
  --border-light: var(--foreground)/ 0.06;
  --highlight: var(--highlight-color);
  --button-background: var(--button-bg);
  --button-gradient: var(--button-bg-gradient);
  --button-border: var(--button-bg);
  --button-text: var(--button-text-color);
  --weight-normal: 400;
  --weight-medium: 500;
  --weight-bold: 700;
  --ease-nav: 0.5s cubic-bezier(0.6, 0, 0.4, 1);
  --ease-primary: 0.5s cubic-bezier(0.3, 1, 0.3, 1);
  --ease-smooth: 0.7s cubic-bezier(0.7, 0, 0.3, 1);
  --ease-fast: 0.3s cubic-bezier(0.7, 0, 0.3, 1);
  --ease-short: 0.2s cubic-bezier(0.7, 0, 0.3, 1);
  /* Fluid font sizes */
  --fluid-2xl-4xl: clamp(var(--font-2xl), 10.0912px + 1.3636vw, var(--font-4xl));
  --fluid-xl-3xl: clamp(var(--font-xl), 7.9456px + 1.1818vw, var(--font-3xl));
  --fluid-lg-2xl: clamp(var(--font-lg), 15.5552px + 0.4444vw, var(--font-2xl));
  --fluid-base-xl: clamp(var(--font-base), 13.968px + 0.3175vw, var(--font-xl));
  --fluid-base-2xl: clamp(var(--font-base), 11.936px + 0.6349vw, var(--font-2xl));
  --fluid-sm-lg: clamp(var(--font-sm), 11.968px + 0.3174vw, var(--font-lg));
  --fluid-sm-base: clamp(var(--font-sm), 12.984px + 0.1587vw, var(--font-base));
  --fluid-xs-sm: clamp(var(--font-xs), 11.6752px + 0.1013vw, var(--font-sm));
  --radius-default: clamp(var(--space-4), 1.578vw, var(--space-7-5));
  --radius-medium: calc(clamp(1em, 1.7vw, 1.7em) * 1.2);
  --radius-small: calc(clamp(1em, 1.7vw, 1.7em) * 0.5);
  --radius-full: calc(infinity * 1px);
  --input-height: var(--space-13);
  --input-padding-inline: var(--space-6-5);
  /* Heading sizes */
  --heading-0: var(--space-16);
  --heading-1: var(--space-9);
  --heading-2: var(--space-6);
  --heading-3: var(--space-5);
  --heading-4: var(--space-4-5);
  --heading-5: var(--space-4);
  --heading-6: var(--space-4-5);
  --title-sm: clamp(var(--font-2xl), 2.526vw, var(--font-5xl));
  --title-md: clamp(var(--space-8), 3.368vw, var(--space-16));
  --title-lg: clamp(var(--space-10), 3.368vw, var(--space-16));
  --title-xl: clamp(var(--space-12), 7.813vw, var(--space-20));
}

@media screen and (min-width: 768px) {
  :root {
    --heading-1: var(--space-12);
    --heading-2: var(--space-7-5);
    --heading-3: var(--space-6);
    --heading-4: var(--space-5-5);
    --heading-5: var(--space-4-5);
    --heading-6: var(--space-4);
  }
}
@media screen and (min-width: 1024px) {
  :root {
    --title-lg: clamp(var(--space-12), 4.73vw, var(--space-23));
    --title-xl: clamp(var(--space-20), 6.737vw, var(--space-32));
    --heading-1: var(--space-14);
    --heading-2: var(--space-9);
    --heading-3: var(--space-7-5);
    --heading-4: var(--space-6);
    --heading-5: var(--space-5);
  }
}
.hr-connect {
  --hr-green: #27292c;
}
.hr-connect .hr-connect-metrics > .metric-card.btn:hover:not(:disabled) {
  background: transparent;
  color: #27292c;
  box-shadow: none;
}
.hr-connect .hr-connect-metrics > .metric-card.btn:hover:not(:disabled) svg {
  transform: none;
}
.hr-connect .hr-record {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  padding: 19px 0;
  width: 100%;
  text-align: left;
}
.hr-connect input:focus-visible,
.hr-connect select:focus-visible {
  outline: 2px solid #27292c;
  outline-offset: 3px;
}

.hr-header-actions,
.hr-context-note {
  display: flex;
  align-items: center;
  gap: var(--space-sm, 10px);
}

.hr-header-actions {
  flex-shrink: 0;
}

.hr-tabs {
  display: flex;
  gap: var(--space-lg, 24px);
  overflow-x: auto;
  border-bottom: 1px solid #e6e8eb;
  margin-bottom: var(--space-lg, 24px);
}
.hr-tabs button {
  display: flex;
  align-items: center;
  gap: 7px;
  flex-shrink: 0;
}
.hr-tabs button > span {
  padding: 2px 6px;
  background: #f1f2f4;
  border-radius: var(--radius-sm, 5px);
  font-size: var(--font-xs, 10px);
}

.hr-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 235px;
  padding: 32px;
  text-align: center;
  color: #6c727a;
  gap: var(--space-md, 12px);
}
.hr-empty > svg {
  background: #fbfbfb;
  box-sizing: content-box;
  padding: 15px;
  border: 1px solid #e6e8eb;
  border-radius: var(--radius-card, 12px);
}
.hr-empty h3 {
  color: #27292c;
  font-size: var(--font-sm, 13px);
  font-weight: 500;
}
.hr-empty p {
  font-size: var(--font-xs, 11px);
  line-height: 1.8;
  max-width: 290px;
}

.hr-records {
  padding: 0 var(--space-lg, 24px) var(--space-md, 12px);
}

.hr-record-icon {
  display: grid;
  place-items: center;
  width: 36px;
  height: 38px;
  flex-shrink: 0;
  background: #fbfbfb;
  border-radius: var(--radius-sm, 8px);
}

.hr-record-copy {
  display: block;
  flex: 1;
  min-width: 0;
}
.hr-record-copy strong {
  display: block;
  font-size: var(--font-sm, 12px);
  font-weight: 500;
  color: #27292c;
  overflow-wrap: anywhere;
}
.hr-record-copy > span {
  display: block;
  color: #6c727a;
  font-size: var(--font-xs, 10px);
  margin-top: 6px;
}
.hr-record-copy p {
  font-size: var(--font-xs, 11px);
  line-height: 1.8;
  color: #6c727a;
  margin-top: 9px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  overflow-wrap: anywhere;
}

.hr-badge {
  display: inline-block;
  padding: 3px 7px;
  border-radius: var(--radius-sm, 5px);
  border: 1px solid #e6e8eb;
  color: #4b4f56;
  background: #fbfbfb;
  font-size: var(--font-2xs, 9px);
  white-space: nowrap;
}
.hr-badge--urgent {
  color: #ed6c02;
  background: #fff4e5;
  border-color: #ffe0b2;
}

.hr-quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding: 24px var(--space-lg, 24px) var(--space-lg, 24px);
  gap: var(--space-md, 12px);
}
.hr-quick-actions button {
  display: flex;
  align-items: center;
  gap: var(--space-md, 12px);
  text-align: left;
}
.hr-quick-actions button > span {
  flex: 1;
}
.hr-quick-actions strong {
  display: block;
  color: #27292c;
  font-size: var(--font-xs, 11px);
  font-weight: 500;
}
.hr-quick-actions small {
  display: block;
  color: #6c727a;
  font-size: var(--font-xs, 10px);
  margin-top: 6px;
  line-height: 1.6;
}

.hr-resources {
  padding: 0 var(--space-lg, 24px);
}
.hr-resources button {
  display: flex;
  width: 100%;
  align-items: center;
  gap: var(--space-md, 12px);
}
.hr-resources button svg:last-child {
  margin-left: auto;
}

.hr-mail-note {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md, 12px);
  padding: 17px 24px;
  background: #fbfbfb;
  border-top: 1px solid #e6e8eb;
  color: #27292c;
}
.hr-mail-note > svg {
  flex-shrink: 0;
}
.hr-mail-note strong {
  font-size: var(--font-xs, 11px);
  font-weight: 500;
  color: #27292c;
}
.hr-mail-note p {
  font-size: var(--font-xs, 10px);
  line-height: 1.8;
  margin-top: 5px;
}

.hr-toolbar {
  display: flex;
  gap: var(--space-md, 12px);
  margin: 4px 24px 20px;
}
.hr-toolbar label {
  display: flex;
  align-items: center;
  flex: 1;
  gap: var(--space-sm, 10px);
  border: 1px solid #e6e8eb;
  border-radius: var(--radius-sm, 7px);
  background: #fbfbfb;
  padding: 0 12px;
  color: #6c727a;
}
.hr-toolbar input {
  width: 100%;
  min-width: 0;
  border: 0;
  background: transparent;
  padding: 11px 0;
  font-size: var(--font-sm, 12px);
  color: #27292c;
}
.hr-toolbar select {
  font-size: var(--font-xs, 11px);
  border: 1px solid #e6e8eb;
  border-radius: var(--radius-sm, 7px);
  padding: 8px 12px;
  color: #4b4f56;
  background: #ffffff;
}

.hr-inline-note {
  font-size: var(--font-sm, 12px);
  padding: 12px 24px;
  color: #ed6c02;
}

.hr-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.hr-form > p {
  margin: 0;
}
.hr-form .hr-form-recipient {
  grid-column: 1/-1;
}
.hr-form-hint {
  font-size: var(--font-sm, 12px);
  color: #6c727a;
  line-height: 1.8;
}
.hr-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: var(--font-sm, 12px);
  font-weight: 500;
  color: #27292c;
}
.hr-form input,
.hr-form select,
.hr-form textarea {
  width: 100%;
  background: #ffffff;
  border: 1px solid #e6e8eb;
  border-radius: var(--radius-sm, 7px);
  padding: 10px 12px;
  font: inherit;
  color: #27292c;
}
.hr-form textarea {
  resize: vertical;
}
.hr-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.hr-form-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10px;
  border-top: 1px solid #e6e8eb;
  padding-top: 18px;
}
.hr-form :focus-visible {
  outline: 2px solid #27292c;
  outline-offset: 3px;
}

.hr-error {
  color: #d32f2f;
  background: #fdeded;
  padding: 12px;
  font-size: var(--font-sm, 12px);
  border-radius: var(--radius-sm, 7px);
}

.hr-detail {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16px;
}
.hr-detail h2 {
  font-size: var(--font-xl, 20px);
  color: #27292c;
  overflow-wrap: anywhere;
}
.hr-detail h3 {
  font-size: var(--font-sm, 13px);
  color: #27292c;
}
.hr-detail-meta {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
  color: #6c727a;
  font-size: var(--font-xs, 10px);
}

.hr-message-body {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-size: var(--font-sm, 13px);
  line-height: 1.9;
  color: #4b4f56;
  border-block: 1px solid #e6e8eb;
  padding: 18px 0;
}

.hr-history {
  border-left: 2px solid #484b50;
  padding-left: 14px;
}
.hr-history strong {
  display: block;
  font-size: var(--font-sm, 12px);
  color: #27292c;
}
.hr-history small {
  font-size: var(--font-xs, 10px);
  color: #6c727a;
}
.hr-history p {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-size: var(--font-sm, 12px);
  margin-top: 7px;
  color: #4b4f56;
}

@media (max-width: 600px) {
  .hr-header-actions {
    flex-wrap: wrap;
  }
  .hr-tabs {
    gap: 18px;
  }
  .hr-quick-actions {
    grid-template-columns: 1fr;
    padding: 0 16px 16px;
  }
  .hr-records {
    padding: 0 16px 12px;
  }
  .hr-record > svg:last-child {
    display: none;
  }
  .hr-record-icon {
    display: none;
  }
  .hr-toolbar {
    margin-inline: 16px;
    flex-wrap: wrap;
  }
  .hr-form-grid {
    grid-template-columns: 1fr;
  }
}
.hr-connect .hr-overview-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
  align-items: start;
  gap: var(--space-lg, 24px);
  margin-bottom: var(--space-lg, 24px);
}
.hr-connect .hr-overview-grid > .card {
  margin: 0;
}
.hr-connect .hr-tabs.card {
  margin: 0 0 var(--space-lg, 24px);
  padding: 10px;
  gap: 8px;
  border: 0;
}
.hr-connect .hr-tabs.card button {
  min-height: 40px;
}
.hr-connect .hr-record.btn {
  border: 0;
  border-bottom: 1px solid #e6e8eb;
  border-radius: 0;
  background: transparent;
  white-space: normal;
}
.hr-connect .hr-record.btn:last-child {
  border-bottom: 0;
}
.hr-connect .hr-record.btn:hover:not(:disabled) {
  background: #fbfbfb;
}
.hr-connect .hr-record.btn:focus-visible {
  outline: 2px solid #27292c;
  outline-offset: -2px;
}
.hr-connect .hr-quick-actions .btn {
  min-height: 76px;
  justify-content: flex-start;
  border-radius: 10px;
  border: 1px solid #e6e8eb;
  background: #ffffff;
  box-shadow: none;
  transform: none;
}
.hr-connect .hr-quick-actions .btn:hover:not(:disabled) {
  background: #fbfbfb;
  border-color: #27292c;
  box-shadow: none;
  transform: none;
}
.hr-connect .hr-quick-actions .btn:hover:not(:disabled) svg {
  transform: none;
}
.hr-connect .hr-quick-actions .btn {
  padding: 16px;
  white-space: normal;
}
.hr-connect .hr-quick-actions .btn > svg {
  flex-shrink: 0;
}
.hr-connect .hr-quick-actions .btn > svg:first-child {
  color: #27292c;
}
.hr-connect .hr-resources {
  display: grid;
  gap: 0;
  padding-block: 8px;
}
.hr-connect .hr-resources .btn {
  justify-content: flex-start;
  min-height: 48px;
  padding: 12px 0;
  border: 0;
  border-bottom: 1px solid #e6e8eb;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  text-align: left;
  white-space: normal;
}
.hr-connect .hr-resources .btn:last-child {
  border-bottom: 0;
}
.hr-connect .hr-resources .btn:hover:not(:disabled) {
  background: #fbfbfb;
  box-shadow: none;
  transform: none;
}
.hr-connect .hr-resources .btn:hover:not(:disabled) svg {
  transform: none;
}
.hr-connect .hr-mail-note p {
  color: #6c727a;
}
@media (max-width: 1000px) {
  .hr-connect .hr-overview-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
@media (max-width: 600px) {
  .hr-connect .hr-quick-actions {
    padding: 16px;
  }
  .hr-connect .hr-record {
    gap: 8px;
    flex-wrap: wrap;
  }
  .hr-connect .hr-record-copy {
    flex-basis: 65%;
  }
}
